# LLM advice (Claude and/or Gemini)
ANTHROPIC_API_KEY=your_key_here
GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini

# Database — local Docker Compose (default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mirror_lake

# Database — staging/production (Supabase example)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Test database (pytest; optional separate DB)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mirror_lake_test

# JWT (auth)
JWT_SECRET=change_me_in_production
JWT_EXPIRE_MINUTES=10080

# Environment data providers
OPENWEATHER_API_KEY=your_openweather_key_here
GOOGLE_POLLEN_API_KEY=your_google_pollen_key_here
# Deprecated alias (still supported): GOOGLE_MAPS_API_KEY=

# Provider selection: openmeteo (free, no key) or openweather (best AAMOS parity)
ENV_PROVIDER=openmeteo

# Cache TTL in seconds (default 21600 = 6 hours for today; past dates use 7 days)
ENV_CACHE_TTL_SECONDS=21600
